{
  "title": "’FACE to ’face",
  "author": "’FACE",
  "chapters": [
    { "id": "1", "title": "「音が止んで、鳴っていたと気づく」", "path": "chapters/01_otogayande.md" },
    { "id": "2", "title": "「家で食べるほうがうまいなら、それでいい」", "path": "chapters/02_iedetaberuhou.md" },
    { "id": "3", "title": "「壁より先に、補給を見る」", "path": "chapters/03_kabeyorisaki.md" },
    { "id": "4", "title": "「高いかどうかは、使った日で決まる」", "path": "chapters/04_takaikadouka.md" },
    { "id": "5", "title": "「棚を買う前に、置き場所を決める」", "path": "chapters/05_tanawokaumae.md" },
    { "id": "6", "title": "「蛇口をひねれば、水が出る」", "path": "chapters/06_jaguchi.md" },
    { "id": "7", "title": "「分からない言葉を、教えてもらう」", "path": "chapters/07_oshietemorau.md" },
    { "id": "8", "title": "「気分より、決まりに任せる」", "path": "chapters/08_kimeruzutoru.md" }
  ]
